# Environment variables for the Node runtime (`pnpm dev` / `pnpm start`).
# Copy this file to `.env` and edit. dotenv loads `.env` at the entry
# point (`scripts/listen.node.ts`); `vite dev` reads `.env` itself.
#
# Persistence is in-memory (packages/core/src/adapters/memory/) — there
# is no database to configure, and all data resets on restart.

# --- Required ----------------------------------------------------------------

# Public origin of the app. Used to build absolute URLs (verification
# links, share URLs) and the OAuth `redirect_uri`. `vite dev` binds to
# this URL's port, so changing it here moves the dev server with it; the
# port is strict, so a busy port fails the boot instead of shifting to
# the next one and leaving `redirect_uri` pointing at the old one.
# `pnpm start` binds to PORT instead, because behind a reverse proxy the
# public origin and the bound port are not the same thing.
APP_URL=http://localhost:3000

# Sign-in identity provider. Exactly one of the two setups below must be
# configured or boot fails (the app never falls back to a fake silently).
#
# 1. Loopback dev IdP: an in-app consent screen at /dev/oauth/authorize
#    lets you run the whole OAuth flow — approve AND cancel — without
#    Google credentials. It signs in whoever is typed into that screen,
#    so it ships commented out: uncomment it for local development
#    (`pnpm dev`) and never on a deployed host. Boot accepts it only
#    under NODE_ENV=development, which only `vite dev` sets — every
#    other value, including unset, empty, and `staging`, refuses to
#    start with this flag on.
#OAUTH_DEV_MODE=true

# 2. Real Google. Leave OAUTH_DEV_MODE commented out and set both
#    values. The authorized redirect URI is
#    `${APP_URL}/auth/callback/google`.
#GOOGLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_SECRET=

# --- Optional: account deletion ----------------------------------------------

# Signing key for the 30-minute status ticket P-25 polls the deletion
# with (32 bytes, base64url). Unset means a per-process key: deletions
# still run to completion, but a restart makes outstanding tickets
# unreadable and the progress display falls back to "the deletion keeps
# going". Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#DELETION_TICKET_KEY=

# --- Optional: HTTP listener -------------------------------------------------

# Port the Node HTTP server listens on. Defaults to 3000.
#PORT=3000

# Hostname the Node HTTP server binds to. Defaults to 0.0.0.0.
#HOSTNAME=0.0.0.0

# --- Optional: local mail debugging ------------------------------------------

# Log the action URL of every mail the in-memory MailSender "sends"
# (`mail.sent` lines). The verification URL embeds the raw one-shot
# token, so anyone reading the log can take over the account — keep this
# off unless you are running a manual test that needs the link.
#MEMORY_MAIL_LOG_ACTION_URL=true

# --- Optional: outbox / worker tuning ----------------------------------------

# Max outbox rows claimed per relay tick.
#OUTBOX_BATCH_SIZE=100

# Lease window (ms) before a stuck claim becomes reclaimable.
#OUTBOX_LEASE_MS=300000

# Per-event max attempts before quarantine (`failed_at` stamp).
#OUTBOX_MAX_ATTEMPTS=2

# Retention window (ms) before processed outbox rows are pruned.
#OUTBOX_RETENTION_MS=604800000

# Lease window (ms) a scope-task claim holds its rows for. Must cover a
# whole claim batch, not one row: a turn that overruns can settle a row
# another worker has since re-armed, stopping the continuation chain.
#SCOPE_TASK_LEASE_MS=300000
