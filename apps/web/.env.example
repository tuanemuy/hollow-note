# Environment variables for the Node runtime (`pnpm dev` / `pnpm start`).
# Copy this file to `.env` and edit. dotenv loads `.env` at the entry
# point (`scripts/listen.node.ts`); `vite dev` reads `.env` itself.
#
# Persistence is in-memory (packages/core/src/adapters/memory/) — there
# is no database to configure, and all data resets on restart.

# --- Required ----------------------------------------------------------------

# Public origin of the app. Used to build absolute URLs (verification
# links, share URLs). Match the host:port the listener binds to.
APP_URL=http://localhost:3000

# --- Optional: HTTP listener -------------------------------------------------

# Port the Node HTTP server listens on. Defaults to 3000.
#PORT=3000

# Hostname the Node HTTP server binds to. Defaults to 0.0.0.0.
#HOSTNAME=0.0.0.0

# --- Optional: local mail debugging ------------------------------------------

# Log the action URL of every mail the in-memory MailSender "sends"
# (`mail.sent` lines). The verification URL embeds the raw one-shot
# token, so anyone reading the log can take over the account — keep this
# off unless you are running a manual test that needs the link.
#MEMORY_MAIL_LOG_ACTION_URL=true

# --- Optional: outbox / worker tuning ----------------------------------------

# Max outbox rows claimed per relay tick.
#OUTBOX_BATCH_SIZE=100

# Lease window (ms) before a stuck claim becomes reclaimable.
#OUTBOX_LEASE_MS=300000

# Per-event max attempts before quarantine (`failed_at` stamp).
#OUTBOX_MAX_ATTEMPTS=2

# Retention window (ms) before processed outbox rows are pruned.
#OUTBOX_RETENTION_MS=604800000
